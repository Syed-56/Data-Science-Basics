#Iterators
class Counter:
    def __init__(self, limit):
        self.limit = limit
        self.n = 0

    def __iter__(self):
        return self

    def __next__(self):
        if self.n >= self.limit:
            raise StopIteration
        self.n += 1
        return self.n

c = Counter(3)
for x in c:
    print(x)  # 1 2 3

it = iter([10, 20, 30])
print(next(it))  # 10
print(next(it))  # 20

#generators
def counter(limit):
    n = 1
    while n <= limit:
        yield n
        n += 1

for x in counter(3):
    print(x)  # 1 2 3
    
#closures
def make_multiplier(factor):
    def multiply(x):
        return x * factor
    return multiply

double = make_multiplier(2)
triple = make_multiplier(3)
print(double(5))  # 10
print(triple(5))  # 15

#decorators
def make_multiplier(factor):
    def multiply(x):
        return x * factor
    return multiply

double = make_multiplier(2)
triple = make_multiplier(3)
print(double(5))  # 10
print(triple(5))  # 15